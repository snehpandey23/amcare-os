# Database
DATABASE_URL=postgresql://user:password@localhost:5432/amcare_os
DB_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=24h

# HIPAA Compliance
AUDIT_LOG_RETENTION_DAYS=2555
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum

# API Keys
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_WEBHOOK_SECRET=your_zoho_webhook_secret_for_signature_verification
ZOHO_REDIRECT_URI=http://localhost:3010/api/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_WORKDRIVE_FILE_NAME=ai-scrum-projects.json
ZOHO_CRM_MODULE=

KLARITY_API_KEY=your_klarity_api_key
KLARITY_API_URL=https://api.klarity.com

WELLSYNC_API_KEY=your_wellsync_api_key
WELLSYNC_API_URL=https://api.wellsync.com

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AI Scrum Master
PPLX_API_KEY=pplx-your-perplexity-key
AI_SCRUM_MASTER_PORT=3010
AI_SCRUM_MASTER_WEB_PORT=3007
VITE_AI_SCRUM_API_URL=http://localhost:3010
AI_SCRUM_MASTER_WEB_ORIGIN=http://localhost:3007

# Application Ports
STAFF_DASHBOARD_PORT=3001
PATIENT_MANAGEMENT_PORT=3002
OPERATIONS_HUB_PORT=3003
ANALYTICS_ENGINE_PORT=3004
OET_LMS_PORT=3005
OET_LMS_SUBMISSIONS_PORT=3006

# OET LMS Submissions – recordings emailed to supervisor (concierge1@siya.health)
LMS_SUPERVISOR_EMAIL=concierge1@siya.health
# Proxy target for LMS dev when running submissions API (default http://localhost:3006)
# OET_LMS_SUBMISSIONS_ORIGIN=http://localhost:3006
# SMTP (set in integrations/oet-lms-submissions or here) to send emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Environment
NODE_ENV=development
