# CLI deploys from the repo root. Ignore rules are read here, not from apps/siya-health/.vercelignore.
# Raw voice takes, the local A/B page, and the clip report must never upload.
apps/siya-health/internal/
apps/siya-health/internal/vo-raw
apps/siya-health/internal/vo-raw/**
apps/siya-health/internal/vo-preview.html
apps/siya-health/internal/vo-marker.html
apps/siya-health/internal/vo-endpoints.json
apps/siya-health/internal/vo-tail-check.json
apps/siya-health/internal/vo-report.json
apps/siya-health/node_modules
apps/siya-health/node_modules/**
# Investor decks are tracked in git and are not read by the site build or any page.
apps/siya-health/brand/investor
# The rest of brand/ is the same: pages do not reference it, and npm run build still passes with it removed.
apps/siya-health/brand
# Internal notes and generators. Removed in a temp tree; the build's HTML set did not change.
apps/siya-health/audit
apps/siya-health/content
apps/siya-health/exports
apps/siya-health/.cursor
apps/siya-health/previews/serve-homepage-previews.py
apps/siya-health/assets/images/README.md
apps/siya-health/*.md
apps/siya-health/.gitignore
apps/siya-health/.vercelignore
apps/siya-health/netlify.toml
apps/siya-health/seo-generated-urls.txt
apps/siya-health/serve_local.py
apps/siya-health/scripts/*.py
apps/siya-health/scripts/*.sh
