{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@amcare/database": ["./packages/database/src"],
      "@amcare/auth": ["./packages/auth/src"],
      "@amcare/audit": ["./packages/audit/src"],
      "@amcare/api-client": ["./packages/api-client/src"]
    }
  },
  "include": [],
  "exclude": ["node_modules", "dist", "build"]
}
