# Siya Guide defaults to deterministic retrieval (no LLM), even if keys exist.

# Option A — Vercel AI Gateway (only used when LLM opt-in below)
AI_GATEWAY_API_KEY=

# Option B — OpenAI direct
OPENAI_API_KEY=

# Optional model override
# SIYA_ASSISTANT_MODEL=openai/gpt-4.1-mini

# Opt IN to LLM for public Guide (off by default)
# SIYA_GUIDE_DETERMINISTIC=0
