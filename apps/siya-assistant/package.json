{
  "name": "@amcare/siya-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Siya Guide \u2014 constrained public website navigation assistant (not a medical chatbot)",
  "scripts": {
    "dev": "next dev --port 3456 --hostname 127.0.0.1",
    "build": "next build",
    "build:kb": "node scripts/build-public-kb.mjs",
    "start": "next start --port 3456",
    "test:redteam": "npx --yes tsx scripts/run-red-team.ts && npm run test:topics && npm run test:clarify",
    "test:guardrails": "npx --yes tsx scripts/run-red-team.ts --deterministic-only",
    "test:topics": "npx --yes tsx scripts/test-topic-routing.ts",
    "predev": "npm run build:kb",
    "prebuild": "npm run build:kb",
    "test:clarify": "npx --yes tsx scripts/test-clarify.ts",
    "test:handoff": "npx --yes tsx scripts/test-human-handoff.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/react": "^3.0.0",
    "ai": "^6.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
