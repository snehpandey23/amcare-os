{
  "mode": "fail-test",
  "description": "THROWAWAY ONLY — mid-upload fail / simulate_fail_after. Must be _FAIL-TEST-ONLY. Never the working delivery tree.",
  "require_path_substring": "_FAIL-TEST-ONLY",
  "transport": "api",
  "api": {
    "accounts_url_env": "ZOHO_ACCOUNTS_URL",
    "accounts_url_default": "https://accounts.zoho.com",
    "upload_url": "https://www.zohoapis.com/workdrive/api/v1/upload",
    "folders_url": "https://www.zohoapis.com/workdrive/api/v1/files",
    "allow_flat_fallback": false,
    "parent_folder_ids_from_env": {
      "04-Content-Tracker": "WORKDRIVE_FAILTEST_04_ID",
      "05-Carousels": "WORKDRIVE_FAILTEST_05_ID",
      "06-Statics": "WORKDRIVE_FAILTEST_06_ID",
      "07-Video-Prompts": "WORKDRIVE_FAILTEST_07_ID"
    }
  },
  "tracker_csv_git": "apps/siya-health/brand/04-Content-Tracker/CLOUD-PACK-TRACKER.csv",
  "tracker_csv_dest_name": "CLOUD-PACK-TRACKER.csv",
  "approved_status_regex": "(?i)(approved|ready)",
  "required_caption_files_any": [
    "captions/ALL-PLATFORMS.md",
    "captions/instagram.md",
    "ready-to-post/captions/ALL-PLATFORMS.md",
    "ready-to-post/captions/instagram.md"
  ]
}
