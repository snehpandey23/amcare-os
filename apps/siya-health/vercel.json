{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "echo 'No install needed'",
  "redirects": [
    {
      "source": "/terms",
      "destination": "/legal/terms-of-use",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/legal/privacy-policy",
      "permanent": true
    },
    {
      "source": "/mental-health-adhd",
      "destination": "/adhd-care",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "siya.health" }],
      "destination": "https://www.siya.health/$1",
      "permanent": true
    }
  ]
}
