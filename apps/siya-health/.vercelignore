# CLI uploads from the monorepo root read /.vercelignore, not this file.
# This file applies only when the Vercel root directory is apps/siya-health.
# Patterns below are unchanged.
# Stale HTML mirrors — not part of production surface
public/

# Brand asset library (source of truth for photography selection; not a public route)
brand/

# Local Phase 0 backups (never deploy)
.site-snapshots/

# Local QA, voiceover notes, and raw takes. Never deploy.
internal/
internal/vo-preview.html
internal/vo-marker.html
internal/vo-endpoints.json
internal/vo-raw
internal/vo-raw/**
internal/vo-tail-check.json
internal/vo-report.json
