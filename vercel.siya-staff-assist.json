{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @amcare/hipaa-training",
  "outputDirectory": "apps/hipaa-training/.next",
  "ignoreCommand": "bash scripts/vercel/should-build-staff-assist.sh",
  "crons": [
    {
      "path": "/api/cron/weekday-team-messages",
      "schedule": "30 3 * * 1-5"
    },
    {
      "path": "/api/cron/lead-gap-digests",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/shift-roster-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/shift-roster-reminders",
      "schedule": "30 13 * * *"
    }
  ]
}
