# Perplexity (recommended) – use your Perplexity API key
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override model (Perplexity default: sonar; OpenAI default: gpt-4o-mini)
# OET_CHAT_MODEL=sonar
# OET_CHAT_MODEL=sonar-pro

# Optional: OpenAI – only if you're not using Perplexity
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: chat server port (default 3007)
# OET_LMS_CHAT_PORT=3007

# Optional: Redis for dialogue state (leave unset for in-memory)
# REDIS_URL=redis://localhost:6379
